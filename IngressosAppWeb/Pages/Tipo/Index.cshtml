@page
@model IngressosAppWeb.Pages.Tipo.IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Tipo[0].Nome)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Tipo) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Nome)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.TipoId">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.TipoId">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.TipoId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
