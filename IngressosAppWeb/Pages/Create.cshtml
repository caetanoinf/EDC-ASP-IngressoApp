@page "/adicionar-novo"
@model IngressosAppWeb.Pages.CreateModel

<div class="container-md mt-5">
    <h2>@ViewData["Title"]</h2>

    <form method="post">
        <div class="form-group">
            <label asp-for="Ingresso.NomeEvento"></label>
            <input asp-for="Ingresso.NomeEvento" class="form-control" />
            <span asp-validation-for="Ingresso.NomeEvento" class="text-danger"></span>
        </div>

        <div class="form-group mt-2">
            <label asp-for="Ingresso.DataEvento"></label>
            <input asp-for="Ingresso.DataEvento" type="datetime-local" class="form-control" />
            <span asp-validation-for="Ingresso.DataEvento" class="text-danger"></span>
        </div>

        <div class="form-group mt-2">
            <label asp-for="Ingresso.Descricao"></label>
            <textarea asp-for="Ingresso.Descricao" class="form-control"></textarea>
            <span asp-validation-for="Ingresso.Descricao" class="text-danger"></span>
        </div>

        <div class="form-group mt-2">
            <label asp-for="Ingresso.ImagemUrl"></label>
            <input asp-for="Ingresso.ImagemUrl" class="form-control" />
            <span asp-validation-for="Ingresso.ImagemUrl" class="text-danger"></span>
        </div>

        <div class="form-group mt-2">
            <label asp-for="Ingresso.Valor"></label>
            <input asp-for="Ingresso.Valor" type="number" step="0.01" class="form-control" />
            <span asp-validation-for="Ingresso.Valor" class="text-danger"></span>
        </div>

        <div class="form-group mt-2">
            <label asp-for="Ingresso.QuantidadeDisponivel"></label>
            <input asp-for="Ingresso.QuantidadeDisponivel" type="number" class="form-control" />
            <span asp-validation-for="Ingresso.QuantidadeDisponivel" class="text-danger"></span>
        </div>

        <div class="form-group mt-2">
            <label asp-for="Ingresso.Localizacao"></label>
            <input asp-for="Ingresso.Localizacao" class="form-control" />
            <span asp-validation-for="Ingresso.Localizacao" class="text-danger"></span>
        </div>
        
        <div class="form-group mt-2">
            <label asp-for="Ingresso.TipoId" class="control-label"></label>
            
            <select class="form-select" asp-for="Ingresso.TipoId" asp-items="Model.TipoOptionItems">
                <option>Selectione uma opção</option>
            </select>
            
            <span asp-validation-for="Ingresso.TipoId" class="text-danger"></span>
        </div>
        
        <div class="form-group mt-2">
            <label asp-for="Ingresso.Categorias" class="control-label"></label>
            
            <select class="form-select" asp-for="CategoriaIds" asp-items="Model.CategoriaOptionItems">
                <option>Selectione uma opção</option>
            </select>
            
            <span asp-validation-for="Ingresso.Categorias" class="text-danger"></span>
        </div>
        
        <div class="form-group mt-4">
            <button type="submit" class="btn btn-primary">Adicionar</button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
