@page
@model IngressosAppWeb.Pages.Tipos.IndexModel

@{
    ViewData["Title"] = "Tipos";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1>@ViewData["Title"]</h1>

<p>
    <a asp-page="Create">Criar novo</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Tipo[0].Nome)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Tipo) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Nome)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.TipoId">Editar</a> |
                <a asp-page="./Details" asp-route-id="@item.TipoId">Detalhes</a> |
                <a asp-page="./Delete" asp-route-id="@item.TipoId">Deletar</a>
            </td>
        </tr>
}
    </tbody>
</table>
