@page
@model IngressosAppWeb.Pages.Tipos.DeleteModel

@{
    ViewData["Title"] = "Deletar";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1>@ViewData["Title"]</h1>

<h3>Você tem certeza que deseja deletar?</h3>
<div>
    <h4>Tipo</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Tipo.Nome)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Tipo.Nome)
        </dd>
    </dl>
    
    <form method="post">
        <input type="hidden" asp-for="Tipo.TipoId" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-page="./Index">Voltar a lista</a>
    </form>
</div>
